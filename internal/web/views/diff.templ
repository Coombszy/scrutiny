package views

import (
	"github.com/Coombszy/scrutiny/internal/domain"
	"github.com/Coombszy/scrutiny/internal/highlight"
	"github.com/Coombszy/scrutiny/internal/review"
	"github.com/Coombszy/scrutiny/internal/settings"
)

// DiffContext is what a file fragment needs besides the diff itself.
type DiffContext struct {
	PR         domain.PRRef
	Base, Head domain.SHA
	Mode       settings.ViewMode
	// CanComment and CanCommentLeft gate the add-comment buttons.
	CanComment, CanCommentLeft bool
	// File is the change shown, which expanding a gap needs to name.
	File domain.FileChange
	// ExpandLines is how many lines each expand button reveals.
	ExpandLines int
}

// cols is how many columns a row spans in this View Mode.
func (c DiffContext) cols() int {
	if c.Mode == settings.Unified {
		return 3
	}
	return 4
}

templ Diff(c DiffContext, d review.DiffFile) {
	<div class="diff-wrap">
		if len(d.Unplaced) > 0 {
			<div class="unplaced">
				for _, t := range d.Unplaced {
					@Thread(c.PR, t)
				}
			</div>
		}
		if len(d.Hunks) == 0 {
			<p class="note">No content changes.</p>
		} else {
			<table class={ "diff", string(c.Mode) } data-path={ d.Path } data-head={ string(c.Head) } data-new-thread={ newThreadURL(c.PR, c.Base, c.Head, d.Path, c.cols()) }>
				if c.Mode == settings.Unified {
					<colgroup><col class="ln"/><col class="ln"/><col/></colgroup>
				} else {
					<colgroup><col class="ln"/><col/><col class="ln"/><col/></colgroup>
				}
				for _, h := range d.Hunks {
					if h.Header != "" {
						@hunkHeader(c, h.Header, h.Gap)
					} else if h.Gap != nil {
						@expander(c, *h.Gap)
					}
					@DiffRows(c, h.Lines)
				}
				if d.TailGap != nil {
					@expander(c, *d.TailGap)
				}
			</table>
		}
	</div>
}

// DiffRows renders diff lines, with their threads, as table rows.
templ DiffRows(c DiffContext, lines []review.DiffLine) {
	if c.Mode == settings.Unified {
		for _, l := range lines {
			<tr class={ kindClass(l.Kind) }>
				<td class="ln">{ lineNo(l.OldNo) }</td>
				<td class="ln">
					@addComment(c, unifiedSide(l), unifiedLine(l), contextOldLine(l))
					{ lineNo(l.NewNo) }
				</td>
				<td
					class="code"
					if l.Kind != domain.Delete {
						data-line={ itoa(l.NewNo) }
					}
				>@lineTokens(l)</td>
			</tr>
			@ThreadRows(c.PR, l.Threads, 3)
		}
	} else {
		for _, row := range (review.DiffHunk{Lines: lines}).SplitRows() {
			<tr>
				if row.Left != nil {
					<td class={ "ln", kindClass(row.Left.Kind) }>
						if row.Left.Kind == domain.Delete {
							@addComment(c, domain.Left, row.Left.OldNo, 0)
						}
						{ lineNo(row.Left.OldNo) }
					</td>
					<td class={ "code", kindClass(row.Left.Kind) }>@lineTokens(*row.Left)</td>
				} else {
					<td class="ln empty"></td>
					<td class="code empty"></td>
				}
				if row.Right != nil {
					<td class={ "ln", kindClass(row.Right.Kind) }>
						@addComment(c, domain.Right, row.Right.NewNo, 0)
						{ lineNo(row.Right.NewNo) }
					</td>
					<td class={ "code", kindClass(row.Right.Kind) } data-line={ itoa(row.Right.NewNo) }>@lineTokens(*row.Right)</td>
				} else {
					<td class="ln empty"></td>
					<td class="code empty"></td>
				}
			</tr>
			@ThreadRows(c.PR, rowThreads(row), 4)
		}
	}
}

// ExpandedRows are the lines a click on a gap's controls reveals. When
// the gap belongs to a hunk header, the header comes back at the break that
// is left, with controls for the rest; once nothing is hidden it is gone,
// as the lines now run on unbroken. A gap with no header (the end of the
// file) gets a plain expander row for the rest instead.
templ ExpandedRows(c DiffContext, lines []review.DiffLine, rest *review.Gap, restBefore bool, header string) {
	if rest != nil && restBefore {
		@restRow(c, header, *rest)
	}
	@DiffRows(c, lines)
	if rest != nil && !restBefore {
		@restRow(c, header, *rest)
	}
}

templ restRow(c DiffContext, header string, rest review.Gap) {
	if header != "" {
		@hunkHeader(c, header, &rest)
	} else {
		@expander(c, rest)
	}
}

// hunkHeader is a hunk's "@@ … @@" row, with the controls for the hidden
// lines above it right-aligned on the same line.
templ hunkHeader(c DiffContext, header string, gap *review.Gap) {
	<tr class="hunk">
		<td colspan={ itoa(c.cols()) }>
			<div class="hunk-line">
				<span class="hunk-text">{ header }</span>
				if gap != nil {
					@expandActions(c, *gap, header)
				}
			</div>
		</td>
	</tr>
}

// expander is a row of its own for a gap no hunk header sits below: the
// end of the file.
templ expander(c DiffContext, g review.Gap) {
	<tr class="expander">
		<td colspan={ itoa(c.cols()) }>
			@expandActions(c, g, "")
		</td>
	</tr>
}

// expandActions reveal a gap: small gaps open whole; bigger ones a few
// lines at a time from either end (only upwards at the top of the file,
// downwards at the bottom), or whole from the middle. Each replaces the
// row it is on.
templ expandActions(c DiffContext, g review.Gap, header string) {
	<span class="expand-actions">
		if g.Size() <= c.ExpandLines {
			<button hx-get={ contextURL(c, g, review.All, header) } hx-target="closest tr" hx-swap="outerHTML">↕ Show { itoa(g.Size()) } lines</button>
		} else {
			if !g.First {
				<button hx-get={ contextURL(c, g, review.Down, header) } hx-target="closest tr" hx-swap="outerHTML" title="Show the lines below the change above">↓ { itoa(c.ExpandLines) } lines</button>
			}
			<button hx-get={ contextURL(c, g, review.All, header) } hx-target="closest tr" hx-swap="outerHTML">Show all { itoa(g.Size()) } lines</button>
			if !g.Last {
				<button hx-get={ contextURL(c, g, review.Up, header) } hx-target="closest tr" hx-swap="outerHTML" title="Show the lines above the change below">↑ { itoa(c.ExpandLines) } lines</button>
			}
		}
	</span>
}

// addComment is a button that loads the new-thread form below its row, or
// dragged to another line's, for the lines between; the URL comes from the
// table's data-new-thread so each line stays small. oldLine, on a unified
// context line, lets a range from it continue onto deleted lines.
templ addComment(c DiffContext, side domain.DiffSide, line, oldLine int) {
	if c.CanComment && line > 0 && (side == domain.Right || c.CanCommentLeft) {
		<button
			class="add-comment"
			title="Comment on this line, or drag for several"
			data-side={ string(side) }
			data-line={ itoa(line) }
			if oldLine > 0 && c.CanCommentLeft {
				data-old-line={ itoa(oldLine) }
			}
		>+</button>
	}
}

// lineTokens renders a diff line's tokens, wrapping the parts that differ
// from the line it replaces (or is replaced by) in a "chg" span.
templ lineTokens(l review.DiffLine) {
	if l.Changed == nil {
		@tokens(l.Tokens)
	} else {
		for i, t := range l.Tokens {
			if l.Changed[i] {
				<span class="chg">@tokens([]highlight.Token{t})</span>
			} else {
				@tokens([]highlight.Token{t})
			}
		}
	}
}

templ tokens(ts []highlight.Token) {
	for _, t := range ts {
		if t.Class == "" {
			{ t.Text }
		} else {
			<span class={ tokenClass(t.Class) }>{ t.Text }</span>
		}
	}
}

templ Error(status int, message string) {
	@Layout("Error · Scrutiny") {
		<h1>{ itoa(status) }</h1>
		<p>{ message }</p>
	}
}
