package views

import (
	"github.com/Coombszy/scrutiny/internal/domain"
	"github.com/Coombszy/scrutiny/internal/review"
)

// LSPStatus is the top bar's Language Server icon: a ring spins round it
// while a server for the PR starts or indexes, a green tick shows once all
// are ready, and hovering says what each is doing.
templ LSPStatus(langs []review.LanguageStatus, oob bool) {
	<span
		id="lsp-status"
		class={ "lsp-status", "lsp-" + lspOverall(langs) }
		if oob {
			hx-swap-oob="true"
		}
		title={ lspTooltip(langs) }
		role="status"
		aria-label={ lspTooltip(langs) }
	>
		<svg class="lsp-ring" viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="14" r="12.5"></circle></svg>
		<svg class="lsp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1"></path>
			<path d="M16 21h1a2 2 0 0 0 2-2v-5a2 2 0 0 1 2-2 2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"></path>
			<circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"></circle>
		</svg>
		<svg class="lsp-badge lsp-tick" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="6"></circle><path d="M3.3 6.2l1.8 1.8 3.6-3.8"></path></svg>
		<svg class="lsp-badge lsp-cross" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="6"></circle><path d="M4 4l4 4M8 4l-4 4"></path></svg>
	</span>
}

// Palette is the Symbol Search dialog (ctrl+k).
templ Palette(pr domain.PRRef) {
	<dialog id="palette" class="palette" data-symbols={ pr.Path() + "/symbols" }>
		<input type="search" placeholder="Search files and symbols" autocomplete="off" spellcheck="false"/>
		<div class="palette-results"></div>
	</dialog>
}

templ SymbolResults(pr domain.PRRef, results []review.SearchResult) {
	if len(results) == 0 {
		<p class="muted">No matches.</p>
	}
	<ul class="results">
		for _, r := range results {
			<li>
				<a
					class={ "result", templ.KV("in-pr", r.InPR), "marker-" + string(r.Marker) }
					href={ templ.SafeURL(blobURL(pr, r.Path, r.Line)) }
					data-nav-path={ r.Path }
					if r.Line > 0 {
						data-nav-line={ itoa(r.Line) }
					}
					data-nav-in-pr={ boolString(r.InPR) }
				>
					<span class="marker" title={ markerTitle(r.Marker) }></span>
					<span class="name">{ r.Name }</span>
					<span class="kind">{ r.Kind }</span>
					if r.Line > 0 {
						<span class="where muted">{ r.Path }:{ itoa(r.Line) }</span>
					}
				</a>
			</li>
		}
	</ul>
}

// ReferencesPanel lists usages, grouped by file, in the side panel.
templ ReferencesPanel(pr domain.PRRef, refs []review.Reference) {
	<aside id="side-panel" class="side-panel">
		<header>
			<strong>{ usages(len(refs)) }</strong>
			<button data-close-panel title="Close">×</button>
		</header>
		for _, group := range groupByPath(refs) {
			<section>
				<h3 class={ templ.KV("in-pr", group[0].InPR) }>{ group[0].Path }</h3>
				for _, ref := range group {
					if ref.OutsideProject {
						<div class="usage muted">{ itoa(ref.Line) } (outside the repository)</div>
					} else {
						<a
							class="usage"
							href={ templ.SafeURL(blobURL(pr, ref.Path, ref.Line)) }
							data-nav-path={ ref.Path }
							data-nav-line={ itoa(ref.Line) }
							data-nav-in-pr={ boolString(ref.InPR) }
						>
							<span class="ln">{ itoa(ref.Line) }</span>
							<code>{ ref.Text }</code>
						</a>
					}
				}
			</section>
		}
	</aside>
}

// FileViewPage shows a whole file at the PR's head.
templ FileViewPage(pr domain.PRRef, f review.FileView) {
	@Layout(f.Path + " · Scrutiny") {
		<div data-live={ pr.Path() + "/events?head=" + string(f.Head) } hidden></div>
		<header class="pr-header">
			<p><a id="back-to-pr" href={ templ.SafeURL(pr.Path()) }>← { pr.String() }</a></p>
			<h1 class="path">{ f.Path }</h1>
			<p class="muted">
				At <code>{ f.Head.Short() }</code>.
				if f.InPR {
					This file is changed in the pull request.
				}
			</p>
		</header>
		<section class="file" data-path={ f.Path }>
			<table class="diff file-view" data-path={ f.Path } data-head={ string(f.Head) }>
				<colgroup><col class="ln"/><col/></colgroup>
				for i, line := range f.Lines {
					<tr id={ "L" + itoa(i+1) }>
						<td class="ln">{ itoa(i + 1) }</td>
						<td class="code" data-line={ itoa(i + 1) }>@tokens(line)</td>
					</tr>
				}
			</table>
		</section>
		@Palette(pr)
	}
}
