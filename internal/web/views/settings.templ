package views

import (
	"github.com/Coombszy/scrutiny/internal/codehost"
	"github.com/Coombszy/scrutiny/internal/metrics"
	"github.com/Coombszy/scrutiny/internal/servers"
	"github.com/Coombszy/scrutiny/internal/settings"
)

// SettingsForm is the editable settings, with the outcome of the last save.
type SettingsForm struct {
	Settings settings.Settings
	Saved    bool
	Err      string
}

// keyLabels names each rebindable action, in the order they are listed.
var keyLabels = []struct{ Action, Label string }{
	{"symbol_search", "Search files and symbols"},
	{"pr_search", "Jump to a pull request"},
	{"command_palette", "Command palette"},
	{"next_comment", "Next comment"},
	{"prev_comment", "Previous comment"},
	{"current_comment", "Go to the selected comment"},
	{"toggle_view_mode", "Toggle split/unified diff"},
	{"refresh", "Refresh"},
	{"help", "Show keyboard shortcuts"},
	{"back_to_pr", "Back to the pull request"},
}

templ SettingsPage(form SettingsForm, list []servers.Status, activity Activity) {
	@Layout("Settings · Scrutiny") {
		<header class="pr-header">
			<h1>Settings</h1>
			<p class="muted">Changes save as you make them, to Scrutiny's config file.</p>
		</header>
		<div class="settings-layout">
		<div class="settings-main">
		@SettingsFormView(form)
		<section id="language-servers" class="settings-section">
			<h2>Language Servers</h2>
			<p class="muted">
				Code navigation runs a Language Server per language. These come from the
				<a href="https://github.com/mason-org/mason-registry">Mason registry</a>
				and install into Scrutiny's data directory; Scrutiny never installs runtimes such as node or go.
			</p>
			<div class="toolbar">
				<input type="search" name="q" autocomplete="off" placeholder="Filter by name or language" hx-get="/settings/servers/list" hx-trigger="input changed delay:200ms, search" hx-target="#server-list"/>
				<button hx-post="/settings/servers/refresh" hx-target="#server-list">Update registry</button>
			</div>
			@ServerList(list)
		</section>
		</div>
		@ActivityPanel(activity)
		</div>
	}
}

templ SettingsFormView(form SettingsForm) {
	<form id="settings-form" class="settings-form" autocomplete="off" hx-post="/settings" hx-trigger="change" hx-swap="outerHTML">
		<section class="settings-section">
			<h2>General</h2>
			<label>
				<span>Theme</span>
				<span class="theme-picker">
					<select name="theme">
						for _, t := range pageFrom(ctx).Themes {
							<option value={ t.ID } selected?={ t.ID == form.Settings.Theme }>{ t.Name }</option>
						}
					</select>
					<button type="button" hx-get="/settings/themes/new" hx-target="#theme-editor" hx-swap="innerHTML">New theme…</button>
					if t, ok := themeOption(ctx, form.Settings.Theme); ok && t.Custom {
						<button type="button" hx-get={ "/settings/themes/" + t.ID + "/edit" } hx-target="#theme-editor" hx-swap="innerHTML">Edit</button>
						<button
							type="button"
							class="danger"
							hx-post={ "/settings/themes/" + t.ID + "/delete" }
							hx-confirm={ "Delete the theme " + t.Name + "? Its file is removed; this cannot be undone." }
							data-confirm-label="Delete"
							hx-swap="none"
						>Delete</button>
					}
				</span>
			</label>
			<label>
				<span>View Mode</span>
				<select name="view_mode">
					<option value={ string(settings.Split) } selected?={ form.Settings.ViewMode == settings.Split }>Split</option>
					<option value={ string(settings.Unified) } selected?={ form.Settings.ViewMode == settings.Unified }>Unified</option>
				</select>
			</label>
			<label>
				<span>Collapse diffs over</span>
				<span><input type="number" name="collapse_threshold" min="1" value={ itoa(form.Settings.Diff.CollapseThreshold) }/> changed lines</span>
			</label>
			<label>
				<span>Port</span>
				<span><input type="number" name="port" min="1" max="65535" value={ itoa(form.Settings.Port) }/> <span class="muted">applies when <code>scrutiny serve</code> restarts</span></span>
			</label>
		</section>
		<section class="settings-section">
			<h2>Keyboard shortcuts</h2>
			<p class="muted">Keys separated by spaces, with optional modifiers, e.g. <code>ctrl+k</code> or <code>] c</code>. Single keys only work outside text boxes.</p>
			for _, k := range keyLabels {
				<label>
					<span>{ k.Label }</span>
					<input type="text" name={ "key." + k.Action } value={ form.Settings.Keys[k.Action] } autocomplete="off" spellcheck="false"/>
				</label>
			}
		</section>
		<p class="settings-status" aria-live="polite">
			if form.Err != "" {
				<span class="settings-error">Not saved: { form.Err }</span>
			} else if form.Saved {
				<span class="settings-saved">Saved</span>
			}
		</p>
	</form>
}

// Activity is what the Settings page's Activity panel shows.
type Activity struct {
	Series    []metrics.Series // nil when metrics are not collected
	RateLimit codehost.RateLimit
}

// ActivityPanel shows Scrutiny's recent GitHub and git activity, per
// minute over the last hour, refreshing itself quietly.
templ ActivityPanel(a Activity) {
	<aside id="activity-panel" class="activity-panel" hx-get="/settings/metrics" hx-trigger="every 30s" hx-swap="outerHTML" data-quiet>
		<h2>Activity</h2>
		if a.RateLimit.Limit > 0 {
			<p class="rate-limit" title="The GitHub API rate limit closest to running out">
				GitHub { rateLimitName(a.RateLimit.Resource) } limit: <strong>{ thousands(a.RateLimit.Remaining) } of { thousands(a.RateLimit.Limit) }</strong> left
				if !a.RateLimit.Reset.IsZero() {
					<span class="muted">(resets { a.RateLimit.Reset.Local().Format("15:04") })</span>
				}
			</p>
		}
		if a.Series == nil {
			<p class="muted">Activity is not being recorded.</p>
		} else {
			<table class="activity">
				<thead><tr><th></th><th>Last hour</th><th>24h</th></tr></thead>
				<tbody>
					for _, s := range a.Series {
						<tr class={ templ.KV("bad", s.Bad && s.LastDay > 0) }>
							<td>
								<div>{ s.Label }</div>
								@spark(s)
							</td>
							<td class="num">{ thousands(s.LastHour) }</td>
							<td class="num">{ thousands(s.LastDay) }</td>
						</tr>
					}
				</tbody>
			</table>
			<p class="muted">Per minute over the last hour; kept for a week.</p>
		}
	</aside>
}

// spark is a bar per minute of the last hour.
templ spark(s metrics.Series) {
	<svg class={ "spark", templ.KV("spark-bad", s.Bad) } viewBox="0 0 120 20" preserveAspectRatio="none" aria-hidden="true">
		for i, n := range s.Minutes {
			if n > 0 {
				<rect x={ itoa(i * 2) } y={ sparkY(n, s.Max()) } width="1.6" height={ sparkH(n, s.Max()) }></rect>
			}
		}
	</svg>
}
