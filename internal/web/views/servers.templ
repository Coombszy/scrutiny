package views

import (
	"strconv"
	"strings"

	"github.com/Coombszy/scrutiny/internal/navigator"
	"github.com/Coombszy/scrutiny/internal/servers"
)

templ ServerList(list []servers.Status) {
	<div id="server-list" class="server-list">
		if len(list) == 0 {
			<p class="muted">No matching Language Servers.</p>
		}
		for _, st := range list {
			@ServerRow(st)
		}
	</div>
}

templ ServerRow(st servers.Status) {
	<div
		class="server"
		id={ "server-" + st.Name }
		if st.Job != nil && st.Job.State == servers.Installing {
			hx-get={ "/settings/servers/" + st.Name }
			hx-trigger="every 1s"
			hx-swap="outerHTML"
			data-quiet
		}
	>
		<div class="server-info">
			<strong>{ st.Name }</strong>
			<span class="muted">{ strings.Join(st.Languages, ", ") }</span>
			if st.Description != "" {
				<p class="muted">{ st.Description }</p>
			}
		</div>
		<div class="server-state">
			switch {
				case st.Job != nil && st.Job.State == servers.Installing:
					<span class="spinner"></span> Installing { st.Version }…
				case st.Installed != nil:
					<span class="badge state-open">Installed { st.Installed.Version }</span>
					if st.Installed.Version != st.Version && st.Version != "" {
						<button hx-post={ "/settings/servers/" + st.Name + "/install" } hx-target="closest .server" hx-swap="outerHTML">Update to { st.Version }</button>
					}
					<button hx-post={ "/settings/servers/" + st.Name + "/remove" } hx-target="closest .server" hx-swap="outerHTML">Remove</button>
				case st.Unsupported != "":
					<span class="muted">Not installable: { st.Unsupported }</span>
				case len(st.Missing) > 0:
					<span class="requires">Requires { strings.Join(st.Missing, " and ") }</span>
				default:
					<button hx-post={ "/settings/servers/" + st.Name + "/install" } hx-target="closest .server" hx-swap="outerHTML">Install { st.Version }</button>
			}
			if st.Job != nil && st.Job.State == servers.Failed {
				<pre class="install-error">{ st.Job.Err }</pre>
			}
		</div>
		if st.Installed != nil {
			@serverLogDetails(st)
		}
	</div>
}

// serverLogDetails folds away an installed server's recent log, loaded when
// opened; it starts open when the log has errors.
templ serverLogDetails(st servers.Status) {
	<details class="server-log" open?={ st.LogErrors > 0 }>
		<summary>
			Logs
			if st.LogErrors > 0 {
				<span class="log-errors">· { plural(st.LogErrors, "error") }</span>
			}
		</summary>
		<div
			class="server-log-body"
			hx-get={ "/settings/servers/" + st.Name + "/log" }
			if st.LogErrors > 0 {
				hx-trigger="load"
			} else {
				hx-trigger="toggle from:closest details once"
			}
			hx-swap="outerHTML"
		></div>
	</details>
}

// ServerLog is an installed server's recent log, newest last.
templ ServerLog(name string, entries []navigator.LogEntry) {
	<div class="server-log-body">
		if len(entries) == 0 {
			<p class="muted">No output yet: the log fills once the server runs for a pull request.</p>
		} else {
			<ol class="server-log-lines">
				for _, e := range entries {
					<li class={ "log-" + string(e.Level) }>
						<time datetime={ e.Time.Format("2006-01-02T15:04:05Z07:00") }>{ e.Time.Format("15:04:05") }</time>
						<span class="log-source">{ e.Source }</span>
						<span class="log-text">{ e.Text }</span>
					</li>
				}
			</ol>
		}
		<button hx-get={ "/settings/servers/" + name + "/log" } hx-target="closest .server-log-body" hx-swap="outerHTML">Refresh</button>
	</div>
}

// plural is n and noun, plural unless n is 1.
func plural(n int, noun string) string {
	if n == 1 {
		return "1 " + noun
	}
	return strconv.Itoa(n) + " " + noun + "s"
}
