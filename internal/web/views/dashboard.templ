package views

import (
	"github.com/Coombszy/scrutiny/internal/domain"
	"github.com/Coombszy/scrutiny/internal/review"
)

// Dashboard renders at once from what is cached. The GitHub lists are
// fetched again only when missing or over ten minutes old, or on Refresh,
// since GitHub's search takes seconds.
templ Dashboard(d review.DashboardPage, cached bool) {
	@Layout("Dashboard") {
		<div class="dashboard-top">
			<form class="open-pr" action="/open" method="get" autocomplete="off">
				<input type="url" name="url" placeholder="Paste a GitHub pull request URL" required/>
				<button type="submit">Open</button>
			</form>
			@dashboardStatus(d, cached, !cached || d.Stale, false)
		</div>
		if !cached || d.Stale {
			<div id="dashboard-lists" hx-get="/dashboard/lists" hx-trigger="load" hx-swap="outerHTML">
				if cached {
					@prList("Review requested", d.ReviewRequested)
					@prList("Authored", d.Authored)
				} else {
					<p class="muted"><span class="spinner"></span> Loading your pull requests from GitHub…</p>
				}
			</div>
		} else {
			@dashboardLists(d)
		}
		<dialog id="pr-search" class="palette">
			<input type="search" placeholder="Search pull requests, or paste a PR URL or owner/repo#123" autocomplete="off" spellcheck="false"/>
			<div class="palette-results"><ul class="results"></ul></div>
		</dialog>
		<section class="pr-list">
			<h2>Recently opened</h2>
			if len(d.Recent) == 0 {
				<p class="muted">Nothing yet.</p>
			}
			<ul>
				for _, v := range d.Recent {
					<li>
						<a href={ templ.SafeURL(v.PR.Path()) }>{ v.Title }</a>
						<span class="muted">{ v.PR.String() }</span>
					</li>
				}
			</ul>
		</section>
	}
}

// DashboardLists are the freshly fetched GitHub lists, swapped into the
// page with the status at the top right updated out of band.
templ DashboardLists(d review.DashboardPage) {
	@dashboardLists(d)
	@dashboardStatus(d, true, false, true)
}

templ dashboardLists(d review.DashboardPage) {
	<div id="dashboard-lists">
		@prList("Review requested", d.ReviewRequested)
		@prList("Authored", d.Authored)
	</div>
}

templ prList(title string, prs []domain.PRSummary) {
	<section class="pr-list">
		<h2>{ title }</h2>
		if len(prs) == 0 {
			<p class="muted">None.</p>
		}
		<ul>
			for _, p := range prs {
				<li>
					<a href={ templ.SafeURL(p.Ref.Path()) }>{ p.Title }</a>
					if p.Draft {
						<span class="badge">Draft</span>
					}
					<span class="muted">{ p.Ref.String() } by { p.Author }</span>
				</li>
			}
		</ul>
	</section>
}

// dashboardStatus, at the top right, says when the GitHub lists were
// fetched and offers Refresh; fresh lists update it out of band.
templ dashboardStatus(d review.DashboardPage, fetched, refreshing, oob bool) {
	<div
		id="dashboard-status"
		class="dashboard-status muted"
		if oob {
			hx-swap-oob="true"
		}
	>
		if refreshing {
			<span class="spinner"></span>
			if fetched {
				Refreshing… (updated { ago(d.FetchedAt) })
			} else {
				Loading…
			}
		} else if fetched {
			Updated { ago(d.FetchedAt) }
		}
		<button
			hx-get="/dashboard/lists"
			hx-target="#dashboard-lists"
			hx-swap="outerHTML"
			hx-indicator="#dashboard-status"
			if refreshing {
				disabled
			}
		>Refresh</button>
	</div>
}
