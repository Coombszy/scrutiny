package views

import (
	"github.com/Coombszy/scrutiny/internal/review"
	"github.com/Coombszy/scrutiny/internal/settings"
)

templ PR(p review.PRPage, mode settings.ViewMode) {
	@Layout(p.PR.Title) {
		<div data-live={ p.PR.Ref.Path() + "/events" } hidden></div>
		@OfflineBanner(p.Offline, false)
		@EmptyRefreshBanner()
		<header class="pr-header">
			<div class="pr-title">
				<h1>{ p.PR.Title } <span class="muted">#{ itoa(p.PR.Ref.Number) }</span></h1>
				<button class="primary" data-open-dialog="submit-review">Review @PendingCount(p.Review.Pending, false)</button>
			</div>
			<p class="muted">
				<span class={ "badge", "state-" + string(p.PR.State) }>{ string(p.PR.State) }</span>
				{ p.PR.Author } wants to merge <code>{ p.PR.HeadBranch }</code> into <code>{ p.PR.BaseBranch }</code>
				· <a href={ templ.SafeURL(p.PR.URL) }>GitHub</a>
			</p>
			@Checks(p.Checks)
			@Reactions(p.PR.Ref, p.Review.PRID, p.Review.Reactions)
		</header>
		<details class="conversation-panel">
			<summary>Conversation (<span id="conversation-count">{ itoa(len(p.Review.Conversation)) }</span>)</summary>
			@Conversation(p.PR.Ref, p.Review.Conversation)
		</details>
		<div class="toolbar">
			@comparisonPicker(p)
			if mode == settings.Split {
				<button hx-post="/settings/view-mode" hx-vals={ `{"mode":"unified"}` }>Unified</button>
			} else {
				<button hx-post="/settings/view-mode" hx-vals={ `{"mode":"split"}` }>Split</button>
			}
			<span class="comment-nav">
				<button data-comment-nav="prev" title="Previous comment">↑ Comment</button>
				<button data-comment-nav="next" title="Next comment">↓ Comment</button>
				<label><input type="checkbox" id="nav-include-resolved"/> include resolved</label>
			</span>
		</div>
		if p.Review.Pending != nil && p.Review.Pending.Commit != p.Comparison.Head {
			<p class="notice">
				Your Pending Review is on commit <code>{ p.Review.Pending.Commit.Short() }</code>, so new comments are
				disabled in this Comparison. Replies still work.
			</p>
		}
		<p class="muted">{ itoa(len(p.Files)) } files changed</p>
		for i, f := range p.Files {
			@fileSection(p, i, f)
		}
		if len(p.OtherThreads) > 0 {
			<section class="file other-threads" data-threads={ itoa(len(p.OtherThreads)) } data-unresolved={ itoa(unresolvedThreads(p.OtherThreads)) }>
				<header class="file-header">Review Threads on files outside this Comparison</header>
				<div class="file-body">
					for _, t := range p.OtherThreads {
						@Thread(p.PR.Ref, t)
					}
				</div>
			</section>
		}
		@submitDialog(p.PR.Ref, p.Comparison.Head, p.Review.Pending)
		@Palette(p.PR.Ref)
	}
}

templ comparisonPicker(p review.PRPage) {
	<form class="comparison" method="get" action={ templ.SafeURL(p.PR.Ref.Path()) }>
		if p.Comparison.IsDefault() {
			<strong>All changes</strong>
		} else {
			<a href={ templ.SafeURL(p.PR.Ref.Path()) }>All changes</a>
		}
		<label>
			from
			<select name="first">
				for _, c := range p.Commits {
					<option value={ string(c.SHA) } selected?={ c.SHA == p.Comparison.First }>{ c.SHA.Short() } { c.Headline }</option>
				}
			</select>
		</label>
		<label>
			to
			<select name="last">
				for i, c := range p.Commits {
					<option value={ string(c.SHA) } selected?={ c.SHA == p.Comparison.Last || (p.Comparison.IsDefault() && i == len(p.Commits)-1) }>{ c.SHA.Short() } { c.Headline }</option>
				}
			</select>
		</label>
		<button type="submit">Compare</button>
	</form>
}

templ fileSection(p review.PRPage, i int, f review.FileEntry) {
	<section class={ "file", templ.KV("viewed", f.Viewed == "VIEWED") } id={ fileID(i) } data-path={ f.Path } data-threads={ itoa(f.Threads) } data-unresolved={ itoa(f.Unresolved) }>
		<header class="file-header">
			<span class={ "badge", "status-" + string(f.Status) }>{ string(f.Status) }</span>
			if f.Path != f.OldPath {
				<span class="path">{ f.OldPath + " → " + f.Path }</span>
			} else {
				<span class="path">{ f.Path }</span>
			}
			if f.Threads > 0 {
				<span class="badge" title="Unresolved / all Review Threads">💬 { itoa(f.Unresolved) }/{ itoa(f.Threads) }</span>
			}
			if f.Viewed == "DISMISSED" {
				<span class="badge">Changed since viewed</span>
			}
			<span class="stat"><span class="plus">+{ itoa(f.Additions) }</span> <span class="minus">−{ itoa(f.Deletions) }</span></span>
			<label class="viewed-toggle">
				<input type="checkbox" name="viewed" value="true" checked?={ f.Viewed == "VIEWED" } hx-post={ p.PR.Ref.Path() + "/viewed" } hx-vals={ viewedVals(f.Path) } hx-swap="none"/>
				Viewed
			</label>
		</header>
		<div class="file-body">
			switch {
				case f.Binary:
					<p class="note">Binary file changed.</p>
				case f.Collapse == review.CollapsedGenerated:
					<p class="note">
						Generated file.
						<button hx-get={ FileURL(p.PR.Ref, p.Comparison, f.FileChange) } hx-target="closest .file-body">Load diff</button>
					</p>
				case f.Collapse == review.CollapsedLarge:
					<p class="note">
						Large diff ({ itoa(f.ChangedLines()) } lines changed).
						<button hx-get={ FileURL(p.PR.Ref, p.Comparison, f.FileChange) } hx-target="closest .file-body">Load diff</button>
					</p>
				default:
					<div class="lazy-diff" hx-get={ FileURL(p.PR.Ref, p.Comparison, f.FileChange) } hx-trigger="intersect once" hx-swap="outerHTML">
						<p class="note">Loading…</p>
					</div>
			}
		</div>
	</section>
}
