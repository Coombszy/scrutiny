package views

import (
	"github.com/Coombszy/scrutiny/internal/domain"
	"github.com/Coombszy/scrutiny/internal/review"
	"github.com/Coombszy/scrutiny/internal/settings"
)

templ PR(p review.PRPage, mode settings.ViewMode) {
	@Layout(p.PR.Title + " #" + itoa(p.PR.Ref.Number)) {
		<div data-live={ p.PR.Ref.Path() + "/events?head=" + string(p.PR.HeadSHA) } hidden></div>
		@OfflineBanner(p.Offline, false)
		@RefreshBanner()
		<header class="pr-header">
			<div class="pr-header-side">
				@StatusBox(p.Checks)
			</div>
			<div class="pr-title">
				<h1>{ p.PR.Title } <span class="muted">#{ itoa(p.PR.Ref.Number) }</span></h1>
			</div>
			<p class="muted">
				<span class={ "badge", "state-" + prStateLabel(p.PR) }>{ prStateLabel(p.PR) }</span>
				{ p.PR.Author } wants to merge <code>{ p.PR.HeadBranch }</code> into <code>{ p.PR.BaseBranch }</code>
				· <a href={ templ.SafeURL(p.PR.URL) }>GitHub</a>
			</p>
			if st := p.Review.Stack; st != nil {
				<nav class="stack-nav" aria-label="Stack">
					<span class="badge">Stack { itoa(st.Position) }/{ itoa(st.Size) }</span>
					if parent := st.Parent(); parent != nil {
						<a id="stack-parent" href={ templ.SafeURL(stackURL(p.PR.Ref, parent.Number)) } title="Parent: the PR below this one">← #{ itoa(parent.Number) } { parent.Title }</a>
					}
					if child := st.Child(); child != nil {
						<a id="stack-child" href={ templ.SafeURL(stackURL(p.PR.Ref, child.Number)) } title="Child: the PR above this one">#{ itoa(child.Number) } { child.Title } →</a>
					}
				</nav>
			}
		</header>
		<details class="conversation-panel">
			<summary>Conversation (<span id="conversation-count">{ itoa(len(p.Review.Conversation) + len(p.Review.Reviews)) }</span>)</summary>
			@Conversation(p.PR.Ref, p.Review.Conversation, p.Review.Reviews)
		</details>
		<div class="toolbar">
			@comparisonPicker(p)
		</div>
		if p.Review.Pending != nil && p.Review.Pending.Commit != p.Comparison.Head {
			<p class="notice">
				Your Pending Review is on commit <code>{ p.Review.Pending.Commit.Short() }</code>, so new comments are
				disabled in this Comparison. Replies still work.
			</p>
		}
		<div class="files-bar">
			<span class="muted">{ itoa(len(p.Files)) } files changed</span>
			<span class="files-bar-actions">
				if mode == settings.Split {
					<button hx-post="/settings/view-mode" hx-vals={ `{"mode":"unified"}` }>Unified</button>
				} else {
					<button hx-post="/settings/view-mode" hx-vals={ `{"mode":"split"}` }>Split</button>
				}
				<span class="comment-nav">
					<button data-comment-nav="prev" title="Previous comment">↑ Comment</button>
					<button data-comment-nav="current" title="Go to the selected comment">Current</button>
					<button data-comment-nav="next" title="Next comment">↓ Comment</button>
					<label><input type="checkbox" id="nav-include-resolved" autocomplete="off"/> include resolved</label>
				</span>
				<button class="primary" data-open-dialog="submit-review">Review @PendingCount(p.Review.Pending, false)</button>
			</span>
		</div>
		for i, f := range p.Files {
			@fileSection(p, i, f)
		}
		if len(p.OtherThreads) > 0 {
			<section class="file other-threads" data-threads={ itoa(len(p.OtherThreads)) } data-unresolved={ itoa(unresolvedThreads(p.OtherThreads)) }>
				<header class="file-header">Review Threads on files outside this Comparison</header>
				<div class="file-body">
					for _, t := range p.OtherThreads {
						@Thread(p.PR.Ref, t)
					}
				</div>
			</section>
		}
		@submitDialog(p.PR.Ref, p.Comparison.Head, p.PendingComments)
		@Palette(p.PR.Ref)
	}
}

templ comparisonPicker(p review.PRPage) {
	<form class="comparison" method="get" autocomplete="off" action={ templ.SafeURL(p.PR.Ref.Path()) }>
		if p.Comparison.IsDefault() {
			<strong>All changes</strong>
		} else {
			<a href={ templ.SafeURL(p.PR.Ref.Path()) }>All changes</a>
		}
		if slr := p.SinceLastReview; slr != nil {
			if p.Comparison.First == slr.First && p.Comparison.Last == slr.Last {
				<strong id="since-last-review" data-href={ comparisonURL(p.PR.Ref, slr.First, slr.Last) }>Since your last review</strong>
			} else {
				<a id="since-last-review" href={ templ.SafeURL(comparisonURL(p.PR.Ref, slr.First, slr.Last)) }>Since your last review</a>
			}
		}
		<span class="picker-label">from</span>
		@commitPicker("first", p.Commits, pickedFirst(p))
		<span class="picker-label">to</span>
		@commitPicker("last", p.Commits, pickedLast(p))
		<button type="submit">Compare</button>
	</form>
}

templ fileSection(p review.PRPage, i int, f review.FileEntry) {
	<section class={ "file", templ.KV("viewed", f.Viewed == "VIEWED") } id={ fileID(i) } data-path={ f.Path } data-file-url={ FileURL(p.PR.Ref, p.Comparison, f.FileChange) } data-threads={ itoa(f.Threads) } data-unresolved={ itoa(f.Unresolved) }>
		<header class="file-header">
			<span class={ "badge", "status-" + string(f.Status) }>{ string(f.Status) }</span>
			if f.Path != f.OldPath {
				<span class="path">{ f.OldPath + " → " + f.Path }</span>
			} else {
				<span class="path">{ f.Path }</span>
			}
			if f.Threads > 0 {
				<span class="badge" title="Unresolved / all Review Threads">💬 { itoa(f.Unresolved) }/{ itoa(f.Threads) }</span>
			}
			if f.Viewed == "DISMISSED" {
				<span class="badge">Changed since viewed</span>
			}
			<span class="stat"><span class="plus">+{ itoa(f.Additions) }</span> <span class="minus">−{ itoa(f.Deletions) }</span></span>
			if !f.Binary && (f.Status == "modified" || f.Status == "renamed") {
				<button class="full-toggle" data-full-toggle aria-pressed="false" title="Show the whole file, or only the changes">Full file</button>
			}
			<label class="viewed-toggle">
				<input type="checkbox" name="viewed" value="true" autocomplete="off" checked?={ f.Viewed == "VIEWED" } hx-post={ p.PR.Ref.Path() + "/viewed" } hx-vals={ viewedVals(f.Path) } hx-swap="none"/>
				Viewed
			</label>
		</header>
		<div class="file-body">
			switch {
				case f.Binary:
					<p class="note">Binary file changed.</p>
				case f.Collapse == review.CollapsedGenerated:
					<p class="note">
						Generated file.
						<button hx-get={ FileURL(p.PR.Ref, p.Comparison, f.FileChange) } hx-target="closest .file-body">Load diff</button>
					</p>
				case f.Collapse == review.CollapsedLarge:
					<p class="note">
						Large diff ({ itoa(f.ChangedLines()) } lines changed).
						<button hx-get={ FileURL(p.PR.Ref, p.Comparison, f.FileChange) } hx-target="closest .file-body">Load diff</button>
					</p>
				default:
					<div class="lazy-diff" hx-get={ FileURL(p.PR.Ref, p.Comparison, f.FileChange) } hx-trigger="intersect once" hx-swap="outerHTML">
						<p class="note">Loading…</p>
					</div>
			}
		</div>
	</section>
}

// commitPicker is a select for one end of the Comparison. A native select
// cannot show an option on two lines, so it is a button and a listbox; the
// hidden input carries the choice in the form.
templ commitPicker(name string, commits []domain.Commit, picked domain.SHA) {
	<div class="commit-picker">
		<input type="hidden" name={ name } value={ string(picked) }/>
		<button type="button" class="commit-picker-button" aria-haspopup="listbox" aria-expanded="false" aria-label={ "Comparison " + name + " commit" }>
			for _, c := range commits {
				if c.SHA == picked {
					@commitLabel(c)
				}
			}
		</button>
		<ul class="commit-picker-list" role="listbox" hidden>
			for _, c := range commits {
				<li role="option" data-value={ string(c.SHA) } aria-selected={ boolString(c.SHA == picked) } tabindex="-1">
					@commitLabel(c)
				</li>
			}
		</ul>
	</div>
}

// commitLabel is "{title} {hash}" over the commit's time.
templ commitLabel(c domain.Commit) {
	<span class="commit-line"><span class="commit-title">{ c.Headline }</span> <code class="commit-hash">{ c.SHA.Short() }</code></span>
	<span class="commit-date">{ commitTime(c) }</span>
}
