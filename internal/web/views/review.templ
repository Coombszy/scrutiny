package views

import (
	"github.com/Coombszy/scrutiny/internal/domain"
	"github.com/Coombszy/scrutiny/internal/review"
)

// Thread renders a Review Thread with its comments, reply form and resolve
// button. Every write inside it swaps the whole thread.
templ Thread(pr domain.PRRef, t domain.ReviewThread) {
	@threadView(pr, t, false)
}

// ThreadOOB is a Thread that replaces the one on the page out of band.
templ ThreadOOB(pr domain.PRRef, t domain.ReviewThread) {
	@threadView(pr, t, true)
}

templ threadView(pr domain.PRRef, t domain.ReviewThread, oob bool) {
	<div
		class="thread"
		id={ "thread-" + t.ID }
		if oob {
			hx-swap-oob="true"
		}
		data-resolved={ boolString(t.Resolved) }
	>
		<details open?={ !t.Resolved }>
			<summary class="thread-summary">
				<span class="path">{ threadLocation(t) }</span>
				if t.Resolved {
					<span class="badge">Resolved</span>
				}
				if t.Outdated {
					<span class="badge">Outdated</span>
				}
				<span class="muted">{ commentCount(len(t.Comments)) }</span>
				if len(t.Comments) > 0 {
					@commentID(t.Comments[0].ID)
				}
			</summary>
			for i, c := range t.Comments {
				@commentView(pr, c, "closest .thread", threadSuggestion(t), i > 0)
			}
			<form class="reply" autocomplete="off" hx-post={ pr.Path() + "/threads/" + t.ID + "/replies" } hx-target="closest .thread" hx-swap="outerHTML">
				@markdownEditor(pr, threadSuggestion(t)) {
					<textarea autocomplete="off" id={ "reply-" + t.ID } name="body" rows="2" placeholder="Reply…" required></textarea>
				}
				<div class="actions">
					<button type="submit">Reply</button>
					if t.Resolved && t.ViewerCanUnresolve {
						<button type="button" hx-post={ pr.Path() + "/threads/" + t.ID + "/resolve" } hx-vals={ `{"resolved":"false"}` } hx-target="closest .thread" hx-swap="outerHTML">Unresolve</button>
					} else if !t.Resolved && t.ViewerCanResolve {
						<button type="button" hx-post={ pr.Path() + "/threads/" + t.ID + "/resolve" } hx-vals={ `{"resolved":"true"}` } hx-target="closest .thread" hx-swap="outerHTML">Resolve</button>
					}
				</div>
			</form>
		</details>
	</div>
}

// commentView renders a comment; edits and deletes swap target, the thread
// or Conversation it is in. An edit can add a suggested change to s. showID
// puts the comment's ID in its header; a thread's first comment has its ID
// beside the file name instead.
templ commentView(pr domain.PRRef, c domain.Comment, target string, s suggestion, showID bool) {
	<article class="comment" id={ "comment-" + c.ID }>
		<header>
			<strong>{ c.Author }</strong>
			if !c.CreatedAt.IsZero() {
				<span class="muted">{ c.CreatedAt.Local().Format("2 Jan 2006 15:04") }</span>
			}
			if c.Pending {
				<span class="badge pending">Pending</span>
			}
			if c.ViewerCanUpdate || c.ViewerCanDelete {
				<span class="comment-actions">
					if c.ViewerCanUpdate {
						<button type="button" data-edit-comment title="Edit this comment">Edit</button>
					}
					if c.ViewerCanDelete {
						<button
							type="button"
							class="danger"
							hx-post={ pr.Path() + "/comments/" + c.ID + "/delete" }
							hx-confirm="Delete this comment? This cannot be undone."
							data-confirm-label="Delete"
							hx-target={ target }
							hx-swap="outerHTML"
							title="Delete this comment"
						>Delete</button>
					}
				</span>
			}
			if showID {
				@commentID(c.ID)
			}
		</header>
		<div class="markdown" hx-disable>
			@templ.Raw(c.BodyHTML)
		</div>
		if c.ViewerCanUpdate {
			<form class="edit-comment" autocomplete="off" hidden hx-post={ pr.Path() + "/comments/" + c.ID + "/edit" } hx-target={ target } hx-swap="outerHTML">
				@markdownEditor(pr, s) {
					<textarea autocomplete="off" name="body" rows="3" required>{ c.Body }</textarea>
				}
				<div class="actions">
					<button type="submit">Save</button>
					<button type="button" data-cancel-edit>Cancel</button>
				</div>
			</form>
		}
		@Reactions(pr, c.ID, c.Reactions)
	</article>
}

// commentID shows a comment's ID; clicking it copies the ID, e.g. to hand
// the comment to another tool.
templ commentID(id string) {
	<button type="button" class="comment-id" data-copy={ id } title="Comment ID, click to copy">{ id }</button>
}

// Reactions renders the Reactions on a comment or PR, with a picker.
templ Reactions(pr domain.PRRef, subject string, groups []domain.ReactionGroup) {
	<div class="reactions" id={ "reactions-" + subject }>
		for _, g := range groups {
			if g.Count > 0 {
				<button class={ "reaction", templ.KV("reacted", g.ViewerHasReacted) } hx-post={ pr.Path() + "/reactions" } hx-vals={ reactionVals(subject, g.Content, !g.ViewerHasReacted) } hx-target="closest .reactions" hx-swap="outerHTML" title={ string(g.Content) }>
					{ g.Content.Emoji() } <span>{ itoa(g.Count) }</span>
				</button>
			}
		}
		<details class="reaction-picker">
			<summary title="Add reaction">☺+</summary>
			<div class="picker">
				for _, r := range domain.Reactions {
					<button hx-post={ pr.Path() + "/reactions" } hx-vals={ reactionVals(subject, r, !hasReacted(groups, r)) } hx-target="closest .reactions" hx-swap="outerHTML" title={ string(r) }>{ r.Emoji() }</button>
				}
			</div>
		</details>
	</div>
}

// ThreadRows renders threads as a table row spanning cols columns.
templ ThreadRows(pr domain.PRRef, threads []domain.ReviewThread, cols int) {
	if len(threads) > 0 {
		<tr class="thread-row">
			<td colspan={ itoa(cols) }>
				for _, t := range threads {
					@Thread(pr, t)
				}
			</td>
		</tr>
	}
}

// NewThreadForm is the form for a new Review Thread, as a table row,
// styled as the thread it will become.
templ NewThreadForm(pr domain.PRRef, a ThreadAnchor, cols int) {
	<tr class="thread-row new-thread">
		<td colspan={ itoa(cols) }>
			<div class="thread new">
				<div class="thread-summary">
					<span class="path">{ a.Location() }</span>
					<span class="muted">New comment</span>
				</div>
				<form class="reply" autocomplete="off" hx-post={ pr.Path() + "/threads" } hx-target="closest tr" hx-swap="outerHTML">
					<input type="hidden" name="base" value={ a.Base }/>
					<input type="hidden" name="head" value={ a.Head }/>
					<input type="hidden" name="path" value={ a.Path }/>
					<input type="hidden" name="line" value={ itoa(a.Line) }/>
					<input type="hidden" name="side" value={ a.Side }/>
					if a.StartLine != 0 {
						<input type="hidden" name="start_line" value={ itoa(a.StartLine) }/>
						<input type="hidden" name="start_side" value={ a.StartSide }/>
					}
					<input type="hidden" name="cols" value={ itoa(cols) }/>
					@markdownEditor(pr, a.suggestion()) {
						<textarea autocomplete="off" name="body" rows="3" placeholder="Leave a comment" required autofocus></textarea>
					}
					<div class="actions">
						<button type="submit">Add to review</button>
						<button type="button" data-remove-row>Cancel</button>
					</div>
				</form>
			</div>
		</td>
	</tr>
}

// PendingCount says how many comments the Pending Review holds, e.g.
// "(2 pending)", and nothing when it holds none. It is swapped out of band
// after every write.
templ PendingCount(p *domain.PendingReview, oob bool) {
	<span
		id="pending-count"
		if oob {
			hx-swap-oob="true"
		}
		class="count"
	>
		if p != nil && p.Comments > 0 {
			({ itoa(p.Comments) } pending)
		}
	</span>
}

// PendingList, in the submit dialog, lists the Pending Review's comments;
// each jumps to its thread on the page.
templ PendingList(comments []review.PendingComment, oob bool) {
	<div
		id="pending-list"
		if oob {
			hx-swap-oob="true"
		}
	>
		if len(comments) > 0 {
			<details class="pending-list">
				<summary>{ pendingComments(len(comments)) }</summary>
				<ul>
					for _, c := range comments {
						<li>
							<a href={ templ.SafeURL("#thread-" + c.ThreadID) } data-jump-thread={ c.ThreadID } data-path={ c.Path }>
								<span class="where">{ pendingLocation(c) }</span>
								if c.Reply {
									<span class="badge">Reply</span>
								}
								<span class="excerpt">{ excerpt(c.Body) }</span>
							</a>
						</li>
					}
				</ul>
			</details>
		}
	</div>
}

// Conversation renders the Conversation Comments and the form for a new one.
templ Conversation(pr domain.PRRef, comments []domain.Comment, reviews []domain.SubmittedReview) {
	@conversationView(pr, comments, reviews, false)
}

// conversationView interleaves Conversation Comments with submitted
// reviews, oldest first, as GitHub's conversation does.
templ conversationView(pr domain.PRRef, comments []domain.Comment, reviews []domain.SubmittedReview, oob bool) {
	<section
		id="conversation"
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, e := range conversationEntries(comments, reviews) {
			if e.Review != nil {
				@reviewEvent(*e.Review)
			} else {
				@commentView(pr, *e.Comment, "#conversation", suggestion{}, true)
			}
		}
		<form class="reply" autocomplete="off" hx-post={ pr.Path() + "/comments" } hx-target="#conversation" hx-swap="outerHTML">
			@markdownEditor(pr, suggestion{}) {
				<textarea autocomplete="off" id="conversation-new" name="body" rows="3" placeholder="Add a comment" required></textarea>
			}
			<div class="actions"><button type="submit">Comment</button></div>
		</form>
	</section>
}

templ submitDialog(pr domain.PRRef, head domain.SHA, pending []review.PendingComment) {
	<dialog id="submit-review">
		<form autocomplete="off" hx-post={ pr.Path() + "/review" }>
			<h2>Finish your review</h2>
			@PendingList(pending, false)
			<input type="hidden" name="head" value={ string(head) }/>
			@markdownEditor(pr, suggestion{}) {
				<textarea autocomplete="off" name="body" rows="5" placeholder="Leave a comment"></textarea>
			}
			<fieldset>
				<label><input type="radio" name="event" value="COMMENT" checked/> Comment</label>
				<label><input type="radio" name="event" value="APPROVE"/> Approve</label>
				<label><input type="radio" name="event" value="REQUEST_CHANGES"/> Request changes</label>
			</fieldset>
			<div class="actions">
				<button type="submit">Submit review</button>
				<button type="button" data-close-dialog>Cancel</button>
			</div>
		</form>
	</dialog>
}

// reviewEvent is a submitted review in the Conversation: who, the verdict,
// and its summary if it has one.
templ reviewEvent(r domain.SubmittedReview) {
	<article class={ "review-event", "review-" + string(r.Verdict) } id={ "review-" + r.ID }>
		<header>
			<span class="review-icon" aria-hidden="true">{ reviewIcon(r.Verdict) }</span>
			<strong>{ r.Author }</strong>
			<span class="review-verdict">{ reviewVerdictText(r.Verdict) }</span>
			if !r.SubmittedAt.IsZero() {
				<span class="muted">{ r.SubmittedAt.Local().Format("2 Jan 2006 15:04") }</span>
			}
		</header>
		if r.BodyHTML != "" {
			<div class="markdown" hx-disable>
				@templ.Raw(r.BodyHTML)
			</div>
		}
	</article>
}

// markdownEditor wraps a comment's textarea with Write and Preview tabs and
// a formatting toolbar, as GitHub's comment box has; the toolbar offers a
// suggested change when s names lines to replace.
templ markdownEditor(pr domain.PRRef, s suggestion) {
	<div class="md-editor" data-preview={ pr.Path() + "/markdown" }>
		<div class="md-header">
			<div class="md-tabs" role="tablist">
				<button type="button" role="tab" data-md-tab="write" aria-selected="true">Write</button>
				<button type="button" role="tab" data-md-tab="preview" aria-selected="false">Preview</button>
			</div>
			<div class="md-toolbar" role="toolbar" aria-label="Formatting">
				if s.Start != 0 {
					<button
						type="button"
						data-md="suggestion"
						data-start={ itoa(s.Start) }
						data-end={ itoa(s.End) }
						title="Add a suggestion"
						aria-label="Add a suggestion"
					>
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 1.5h6l3 3v10h-9z"></path><path d="M8 5.5v4M6 7.5h4M6 12h4"></path></svg>
					</button>
					<span class="md-sep"></span>
				}
				<button type="button" data-md="heading" title="Heading" aria-label="Heading"><b>H</b></button>
				<button type="button" data-md="bold" title="Bold (ctrl+b)" aria-label="Bold"><b>B</b></button>
				<button type="button" data-md="italic" title="Italic (ctrl+i)" aria-label="Italic"><i>I</i></button>
				<button type="button" data-md="underline" title="Underline" aria-label="Underline"><u>U</u></button>
				<button type="button" data-md="strike" title="Strikethrough" aria-label="Strikethrough"><s>S</s></button>
				<span class="md-sep"></span>
				<button type="button" data-md="quote" title="Quote" aria-label="Quote">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 2.5v11M6 4h8M6 8h8M6 12h5"></path></svg>
				</button>
				<button type="button" data-md="code" title="Code (ctrl+e)" aria-label="Code">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 4 1.5 8 5 12M11 4l3.5 4-3.5 4"></path></svg>
				</button>
				<button type="button" data-md="link" title="Link" aria-label="Link">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 9.5l3-3M7 4.5l1-1a2.8 2.8 0 0 1 4 4l-1 1M9 11.5l-1 1a2.8 2.8 0 0 1-4-4l1-1"></path></svg>
				</button>
				<span class="md-sep"></span>
				<button type="button" data-md="ordered" title="Numbered list" aria-label="Numbered list">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5h8.5M6 8h8.5M6 12.5h8.5M2 2.5h1v3M1.5 7h2l-2 2.5h2"></path></svg>
				</button>
				<button type="button" data-md="unordered" title="Bulleted list" aria-label="Bulleted list">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5h8.5M6 8h8.5M6 12.5h8.5"></path><circle cx="2.5" cy="3.5" r=".6"></circle><circle cx="2.5" cy="8" r=".6"></circle><circle cx="2.5" cy="12.5" r=".6"></circle></svg>
				</button>
				<button type="button" data-md="task" title="Task list" aria-label="Task list">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M7.5 4h7M7.5 11h7M1.5 4l1.3 1.3L5 2.8"></path><rect x="1.5" y="9" width="3.5" height="3.5" rx=".5"></rect></svg>
				</button>
			</div>
		</div>
		{ children... }
		<div class="markdown md-preview" hx-disable hidden></div>
	</div>
}

// MarkdownPreview is a comment body as rendered by the code host, for a
// comment box's Preview tab.
templ MarkdownPreview(html string) {
	if html == "" {
		<p class="muted">Nothing to preview</p>
	} else {
		@templ.Raw(html)
	}
}
