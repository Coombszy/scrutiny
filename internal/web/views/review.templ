package views

import (
	"github.com/Coombszy/scrutiny/internal/domain"
	"github.com/Coombszy/scrutiny/internal/review"
)

// Thread renders a Review Thread with its comments, reply form and resolve
// button. Every write inside it swaps the whole thread.
templ Thread(pr domain.PRRef, t domain.ReviewThread) {
	@threadView(pr, t, false)
}

// ThreadOOB is a Thread that replaces the one on the page out of band.
templ ThreadOOB(pr domain.PRRef, t domain.ReviewThread) {
	@threadView(pr, t, true)
}

templ threadView(pr domain.PRRef, t domain.ReviewThread, oob bool) {
	<div
		class="thread"
		id={ "thread-" + t.ID }
		if oob {
			hx-swap-oob="true"
		}
		data-resolved={ boolString(t.Resolved) }
	>
		<details open?={ !t.Resolved }>
			<summary class="thread-summary">
				<span class="path">{ threadLocation(t) }</span>
				if t.Resolved {
					<span class="badge">Resolved</span>
				}
				if t.Outdated {
					<span class="badge">Outdated</span>
				}
				<span class="muted">{ commentCount(len(t.Comments)) }</span>
			</summary>
			for _, c := range t.Comments {
				@commentView(pr, c)
			}
			<form class="reply" hx-post={ pr.Path() + "/threads/" + t.ID + "/replies" } hx-target="closest .thread" hx-swap="outerHTML">
				<textarea id={ "reply-" + t.ID } name="body" rows="2" placeholder="Reply…" required></textarea>
				<div class="actions">
					<button type="submit">Reply</button>
					if t.Resolved && t.ViewerCanUnresolve {
						<button type="button" hx-post={ pr.Path() + "/threads/" + t.ID + "/resolve" } hx-vals={ `{"resolved":"false"}` } hx-target="closest .thread" hx-swap="outerHTML">Unresolve</button>
					} else if !t.Resolved && t.ViewerCanResolve {
						<button type="button" hx-post={ pr.Path() + "/threads/" + t.ID + "/resolve" } hx-vals={ `{"resolved":"true"}` } hx-target="closest .thread" hx-swap="outerHTML">Resolve</button>
					}
				</div>
			</form>
		</details>
	</div>
}

templ commentView(pr domain.PRRef, c domain.Comment) {
	<article class="comment" id={ "comment-" + c.ID }>
		<header>
			<strong>{ c.Author }</strong>
			if !c.CreatedAt.IsZero() {
				<span class="muted">{ c.CreatedAt.Local().Format("2 Jan 2006 15:04") }</span>
			}
			if c.Pending {
				<span class="badge pending">Pending</span>
			}
		</header>
		<div class="markdown" hx-disable>
			@templ.Raw(c.BodyHTML)
		</div>
		@Reactions(pr, c.ID, c.Reactions)
	</article>
}

// Reactions renders the Reactions on a comment or PR, with a picker.
templ Reactions(pr domain.PRRef, subject string, groups []domain.ReactionGroup) {
	<div class="reactions" id={ "reactions-" + subject }>
		for _, g := range groups {
			if g.Count > 0 {
				<button class={ "reaction", templ.KV("reacted", g.ViewerHasReacted) } hx-post={ pr.Path() + "/reactions" } hx-vals={ reactionVals(subject, g.Content, !g.ViewerHasReacted) } hx-target="closest .reactions" hx-swap="outerHTML" title={ string(g.Content) }>
					{ g.Content.Emoji() } <span>{ itoa(g.Count) }</span>
				</button>
			}
		}
		<details class="reaction-picker">
			<summary title="Add reaction">☺+</summary>
			<div class="picker">
				for _, r := range domain.Reactions {
					<button hx-post={ pr.Path() + "/reactions" } hx-vals={ reactionVals(subject, r, !hasReacted(groups, r)) } hx-target="closest .reactions" hx-swap="outerHTML" title={ string(r) }>{ r.Emoji() }</button>
				}
			</div>
		</details>
	</div>
}

// ThreadRows renders threads as a table row spanning cols columns.
templ ThreadRows(pr domain.PRRef, threads []domain.ReviewThread, cols int) {
	if len(threads) > 0 {
		<tr class="thread-row">
			<td colspan={ itoa(cols) }>
				for _, t := range threads {
					@Thread(pr, t)
				}
			</td>
		</tr>
	}
}

// NewThreadForm is the form for a new Review Thread, as a table row.
templ NewThreadForm(pr domain.PRRef, a ThreadAnchor, cols int) {
	<tr class="thread-row new-thread">
		<td colspan={ itoa(cols) }>
			<form hx-post={ pr.Path() + "/threads" } hx-target="closest tr" hx-swap="outerHTML">
				<input type="hidden" name="base" value={ a.Base }/>
				<input type="hidden" name="head" value={ a.Head }/>
				<input type="hidden" name="path" value={ a.Path }/>
				<input type="hidden" name="line" value={ itoa(a.Line) }/>
				<input type="hidden" name="side" value={ a.Side }/>
				<input type="hidden" name="cols" value={ itoa(cols) }/>
				<textarea name="body" rows="3" placeholder="Leave a comment" required autofocus></textarea>
				<div class="actions">
					<button type="submit">Add to review</button>
					<button type="button" class="cancel" data-remove-row>Cancel</button>
				</div>
			</form>
		</td>
	</tr>
}

// PendingCount says how many comments the Pending Review holds, e.g.
// "(2 pending)", and nothing when it holds none. It is swapped out of band
// after every write.
templ PendingCount(p *domain.PendingReview, oob bool) {
	<span
		id="pending-count"
		if oob {
			hx-swap-oob="true"
		}
		class="count"
	>
		if p != nil && p.Comments > 0 {
			({ itoa(p.Comments) } pending)
		}
	</span>
}

// PendingList, in the submit dialog, lists the Pending Review's comments;
// each jumps to its thread on the page.
templ PendingList(comments []review.PendingComment, oob bool) {
	<div
		id="pending-list"
		if oob {
			hx-swap-oob="true"
		}
	>
		if len(comments) > 0 {
			<details class="pending-list">
				<summary>{ pendingComments(len(comments)) }</summary>
				<ul>
					for _, c := range comments {
						<li>
							<a href={ templ.SafeURL("#thread-" + c.ThreadID) } data-jump-thread={ c.ThreadID } data-path={ c.Path }>
								<span class="where">{ pendingLocation(c) }</span>
								if c.Reply {
									<span class="badge">Reply</span>
								}
								<span class="excerpt">{ excerpt(c.Body) }</span>
							</a>
						</li>
					}
				</ul>
			</details>
		}
	</div>
}

// Conversation renders the Conversation Comments and the form for a new one.
templ Conversation(pr domain.PRRef, comments []domain.Comment) {
	@conversationView(pr, comments, false)
}

templ conversationView(pr domain.PRRef, comments []domain.Comment, oob bool) {
	<section
		id="conversation"
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, c := range comments {
			@commentView(pr, c)
		}
		<form class="reply" hx-post={ pr.Path() + "/comments" } hx-target="#conversation" hx-swap="outerHTML">
			<textarea id="conversation-new" name="body" rows="3" placeholder="Add a comment" required></textarea>
			<div class="actions"><button type="submit">Comment</button></div>
		</form>
	</section>
}

templ submitDialog(pr domain.PRRef, head domain.SHA, pending []review.PendingComment) {
	<dialog id="submit-review">
		<form hx-post={ pr.Path() + "/review" }>
			<h2>Finish your review</h2>
			@PendingList(pending, false)
			<input type="hidden" name="head" value={ string(head) }/>
			<textarea name="body" rows="5" placeholder="Leave a comment"></textarea>
			<fieldset>
				<label><input type="radio" name="event" value="COMMENT" checked/> Comment</label>
				<label><input type="radio" name="event" value="APPROVE"/> Approve</label>
				<label><input type="radio" name="event" value="REQUEST_CHANGES"/> Request changes</label>
			</fieldset>
			<div class="actions">
				<button type="submit">Submit review</button>
				<button type="button" data-close-dialog>Cancel</button>
			</div>
		</form>
	</dialog>
}
