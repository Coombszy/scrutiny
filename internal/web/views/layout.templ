package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="csrf-token" content={ pageFrom(ctx).CSRFToken }/>
			<title>{ title } · Scrutiny</title>
			<link rel="stylesheet" href="/static/scrutiny.css"/>
			<link rel="stylesheet" href={ "/theme.css?v=" + pageFrom(ctx).Theme }/>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/scrutiny.js" defer></script>
		</head>
		<body
			hx-headers={ csrfHeaders(ctx) }
			data-keys={ toJSON(pageFrom(ctx).Keys) }
			data-themes={ toJSON(pageFrom(ctx).Themes) }
			data-view-mode={ pageFrom(ctx).ViewMode }
		>
			<header class="topbar">
				<a class="brand" href="/">Scrutiny</a>
				if pageFrom(ctx).KeyHelp {
					<span id="help-hint" class="topbar-hint muted">Press <kbd>{ pageFrom(ctx).Keys["help"] }</kbd> { "for keyboard shortcuts" }</span>
				}
				@IndexingSpinner(pageFrom(ctx).Indexing, false)
				<a class="topbar-link" href="/settings/servers">Language Servers</a>
				<span id="activity" class="activity" hidden title="Working…" aria-live="polite"><span class="spinner"></span></span>
			</header>
			<main>
				{ children... }
			</main>
			if pageFrom(ctx).KeyHelp {
				<dialog id="help" class="help">
					<header>
						<h2>Keyboard shortcuts</h2>
						<button class="close" data-close-dialog title="Close (Esc)" aria-label="Close">×</button>
					</header>
					<table class="keys"><tbody></tbody></table>
					if pageFrom(ctx).CodeHelp {
						<h3>Mouse and editing</h3>
						<table class="keys">
							<tbody>
								<tr><td><kbd>ctrl</kbd>/<kbd>cmd</kbd> + click</td><td>Go to definition</td></tr>
								<tr><td>Right-click code</td><td>Go to definition or find usages</td></tr>
								<tr><td><kbd>ctrl</kbd>/<kbd>cmd</kbd> + <kbd>enter</kbd></td><td>Send a comment or reply</td></tr>
								<tr><td><kbd>esc</kbd></td><td>Close dialogs, menus and panels</td></tr>
							</tbody>
						</table>
					}
					<p class="muted">Rebind hotkeys from the Command Palette; single keys only work outside text boxes.</p>
				</dialog>
			}
			<dialog id="commands" class="palette">
				<input type="search" placeholder="Type a command" autocomplete="off" spellcheck="false"/>
				<div class="palette-results"><ul class="results"></ul></div>
			</dialog>
		</body>
	</html>
}
