package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="csrf-token" content={ pageFrom(ctx).CSRFToken }/>
			<title>{ title } · Scrutiny</title>
			<link rel="stylesheet" href="/static/scrutiny.css"/>
			<link rel="stylesheet" href={ "/theme.css?v=" + pageFrom(ctx).Theme }/>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/scrutiny.js" defer></script>
		</head>
		<body
			hx-headers={ csrfHeaders(ctx) }
			data-keys={ toJSON(pageFrom(ctx).Keys) }
			data-themes={ toJSON(pageFrom(ctx).Themes) }
			data-view-mode={ pageFrom(ctx).ViewMode }
		>
			<header class="topbar">
				<a class="brand" href="/">Scrutiny</a>
				<span class="topbar-end">
				if pageFrom(ctx).KeyHelp {
					<span id="help-hint" class="topbar-hint muted"><kbd>{ pageFrom(ctx).Keys["help"] }</kbd> { "for keyboard shortcuts" }</span>
				}
				if pageFrom(ctx).ShowLanguages {
					@LSPStatus(pageFrom(ctx).Languages, false)
				}
				<a class="topbar-link" href="/settings" title="Settings" aria-label="Settings">
					<svg class="cog" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
				</a>
				</span>
			</header>
			<main>
				{ children... }
			</main>
			if pageFrom(ctx).KeyHelp {
				<dialog id="help" class="help">
					<header>
						<h2>Keyboard shortcuts</h2>
						<button class="close" data-close-dialog title="Close (Esc)" aria-label="Close">×</button>
					</header>
					<table class="keys"><tbody></tbody></table>
					if pageFrom(ctx).CodeHelp {
						<h3>Mouse and editing</h3>
						<table class="keys">
							<tbody>
								<tr><td><kbd>ctrl</kbd>/<kbd>cmd</kbd> + click</td><td>Go to definition</td></tr>
								<tr><td><kbd>ctrl</kbd>/<kbd>cmd</kbd> + <kbd>shift</kbd> + click</td><td>Find usages</td></tr>
								<tr><td>Right-click code</td><td>Go to definition or find usages</td></tr>
								<tr><td><kbd>ctrl</kbd>/<kbd>cmd</kbd> + <kbd>enter</kbd></td><td>Send a comment or reply</td></tr>
								<tr><td><kbd>esc</kbd></td><td>Close dialogs, menus and panels</td></tr>
							</tbody>
						</table>
					}
					<p class="muted">Rebind hotkeys from the Command Palette; single keys only work outside text boxes.</p>
				</dialog>
			}
			<dialog id="commands" class="palette">
				<input type="search" placeholder="Type a command" autocomplete="off" spellcheck="false"/>
				<div class="palette-results"><ul class="results"></ul></div>
			</dialog>
		</body>
	</html>
}
