package views

import (
	"github.com/Coombszy/scrutiny/internal/domain"
	"github.com/Coombszy/scrutiny/internal/review"
)

// LiveUpdate renders an Update as out-of-band swaps for the PR page.
templ LiveUpdate(pr domain.PRRef, u review.Update) {
	@refreshUpdate(u)
	if u.OfflineChanged {
		@OfflineBanner(u.Offline, true)
	}
	for _, t := range u.Threads {
		@ThreadOOB(pr, t)
	}
	if u.ConversationChanged {
		@conversationView(pr, u.Conversation, true)
		@ConversationCount(len(u.Conversation))
	}
	if u.PendingChanged {
		@PendingCount(u.Pending, true)
		@PendingList(u.PendingComments, true)
	}
	if u.Checks != nil {
		@statusBox(*u.Checks, true)
	}
	if u.Languages != nil {
		@LSPStatus(u.Languages, true)
	}
}

// refreshUpdate fills in the Refresh banner's messages; each is swapped on
// its own so a later update does not overwrite an earlier one.
templ refreshUpdate(u review.Update) {
	if u.Head != "" {
		<span id="refresh-commits" hx-swap-oob="true">New commits were pushed (head is now <code>{ u.Head.Short() }</code>).</span>
	}
	if u.NewThreads > 0 {
		<span id="refresh-comments" hx-swap-oob="true">New comments were added.</span>
	}
}

// RefreshBanner is shown, by CSS, once either message has arrived.
templ RefreshBanner() {
	<div id="refresh-banner" class="notice live">
		<span id="refresh-commits"></span>
		<span id="refresh-comments"></span>
		<button data-reload>Refresh</button>
	</div>
}

// OfflineBanner says GitHub is unreachable; while it carries data-offline,
// CSS hides every review action.
templ OfflineBanner(offline bool, oob bool) {
	<div
		id="offline-banner"
		if oob {
			hx-swap-oob="true"
		}
		if offline {
			class="notice offline"
			data-offline
		}
	>
		if offline {
			GitHub is unreachable. Showing what was last fetched; review actions are disabled until it is back.
		}
	</div>
}

// StatusBox is the PR's state at the right of the header: whether it is
// draft, merged or closed, where reviews stand, its Checks (expandable when
// there are any) and whether it can merge.
templ StatusBox(c domain.Checks) {
	@statusBox(c, false)
}

templ statusBox(c domain.Checks, oob bool) {
	<aside
		id="pr-status"
		class="pr-status"
		if oob {
			hx-swap-oob="true"
		}
	>
		switch c.PRState {
			case domain.Merged:
				<div class="status-row status-merged"><span class="status-icon">⇄</span> Merged</div>
			case domain.Closed:
				<div class="status-row status-closed"><span class="status-icon">✕</span> Closed</div>
			default:
				if c.Draft {
					<div class="status-row muted"><span class="status-icon">✎</span> Draft: not ready for review</div>
				}
		}
		@reviewsRow(c)
		if len(c.Checks) == 0 {
			<div class="status-row muted"><span class="status-icon">○</span> No Checks</div>
		} else {
			<details id="checks" class="status-row checks">
				<summary>
					<span class={ "status-icon", "check-" + string(checksOutcome(c)) }>{ checkIcon(checksOutcome(c)) }</span>
					{ checksSummary(c) }
				</summary>
				<ul class="check-list">
					for _, ch := range sortedChecks(c.Checks) {
						<li class={ "check", "check-" + string(ch.State) }>
							<span class="check-icon">{ checkIcon(ch.State) }</span>
							if ch.URL != "" {
								<a href={ templ.SafeURL(ch.URL) } target="_blank" rel="noopener">{ checkName(ch) }</a>
							} else {
								{ checkName(ch) }
							}
							if ch.Required {
								<span class="badge">Required</span>
							}
						</li>
					}
				</ul>
			</details>
		}
		if c.ShowMergeState() {
			<div class={ "status-row", "merge-" + string(c.MergeState) }>
				<span class="status-icon">{ mergeIcon(c.MergeState) }</span> { mergeStateLabel(c.MergeState) }
			</div>
		}
	</aside>
}

templ reviewsRow(c domain.Checks) {
	if blockers := c.Reviewers(domain.VerdictChangesRequested); len(blockers) > 0 || c.ReviewDecision == domain.ChangesRequestedDecision {
		<div class="status-row status-blocked"><span class="status-icon">✗</span> { byReviewers("Changes requested", blockers) }</div>
	} else if approvers := c.Reviewers(domain.VerdictApproved); c.ReviewDecision == domain.ReviewRequired && c.PRState == domain.Open {
		<div class="status-row status-waiting">
			<span class="status-icon">●</span> Waiting on approval
			if len(approvers) > 0 {
				<span class="muted">({ byReviewers("approved", approvers) })</span>
			}
		</div>
	} else if len(approvers) > 0 || c.ReviewDecision == domain.ApprovedDecision {
		<div class="status-row status-approved"><span class="status-icon">✓</span> { byReviewers("Approved", approvers) }</div>
	} else {
		<div class="status-row muted"><span class="status-icon">○</span> No reviews yet</div>
	}
}

// ConversationCount updates the Conversation panel's count out of band.
templ ConversationCount(n int) {
	<span id="conversation-count" hx-swap-oob="true">{ itoa(n) }</span>
}
